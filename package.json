{
  "name": "how-it-actually-works",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An interactive, inspectable field guide to how things actually work.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "cloudflare:login": "wrangler login",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:examples && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:examples": "node --test examples/*.test.mjs",
    "examples": "node scripts/run-examples.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.7",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.0.0",
    "wrangler": "4.135.0"
  }
}
